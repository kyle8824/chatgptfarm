{
 "name":"chatgptfarm-live-lab",
 "main":"worker.mjs",
 "compatibility_date":"2026-09-01",
 "workers_dev":true,
 "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true},
 "durable_objects":{"bindings":[{"name":"LIVE_PREVIEW","class_name":"LivePreviewWorld"}]},
 "migrations":[{"tag":"live-lab-v1","new_sqlite_classes":["LivePreviewWorld"]}],
 "observability":{"enabled":true},
 "keep_vars":true
}
